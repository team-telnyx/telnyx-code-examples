# Telnyx API credentials \u2014 never commit real values.
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Voice + text used by the greeting and the nightly canary.
VOICE_ID=Telnyx.Ultra.002622d8-19d0-4567-a16a-f99c7397c062
GREETING_TEXT=Thank you for calling Riverbental Clinic. Today's flu clinic is open until 6 PM. We can help with Novocaine and Dr. Ng.
CANARY_TEXT=Welcome to Riverbental Clinic \u2014 Novocaine and Dr. Ng.

# Nightly canary schedule (local wall-clock HH:MM in CLINIC_TZ).
VERIFY_AT=02:00
CLINIC_TZ=UTC

# Phone numbers \u2014 placeholders only, never real numbers.
INTAKE_NUMBER=+1555XXXXXXX
CLINIC_NUMBERS={}
OWNER_NUMBER=+1555XXXXXXX

# Demo mode (default true \u2014 no live API calls, no real SMS).
DEMO_MODE=true
