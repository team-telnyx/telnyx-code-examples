{
  "name": "collaborative-doc-ai-copilot",
  "version": "0.1.0",
  "description": "Liveblocks-style collaborative document editor on Telnyx Edge Compute: a DocActor StatefulActor holds the document state, the Agent SDK built-in connection surface syncs every participant over WebSocket, and the AI copilot proposes edits via the zero-credential Telnyx Inference binding.",
  "type": "module",
  "private": true,
  "scripts": {
    "local:dev": "esbuild scripts/local-dev.ts --bundle --platform=node --format=esm --target=es2022 --packages=external --outfile=node_modules/.cache/local-dev.mjs && node node_modules/.cache/local-dev.mjs",
    "typecheck": "tsc --noEmit",
    "types": "telnyx-edge types",
    "ship": "telnyx-edge ship",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@telnyx/edge-runtime": "^0.15.1",
    "telnyx": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
