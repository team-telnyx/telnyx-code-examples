# Telnyx Inference runs through the pre-authenticated TELNYX binding on
# Telnyx Edge Compute — no API key is needed for deployed functions.
# A key is only required for LOCAL development (scripts/local-dev.ts calls
# the Telnyx Inference API directly with it).
TELNYX_API_KEY=your_telnyx_api_key_here

# Telnyx Inference model (OpenAI-compatible chat completions)
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Local dev server
PORT=8787
