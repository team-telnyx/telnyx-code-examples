# Telnyx API credentials — get yours at https://portal.telnyx.com/api-keys
TELNYX_API_KEY=KEY_your_telnyx_api_key_here

# Messaging profile that owns the sending number.
TELNYX_MESSAGING_PROFILE_ID=your_messaging_profile_id_here
TELNYX_PHONE_NUMBER=+15551234567

# Base URL used when configuring the webhook in the Telnyx Portal.
PUBLIC_WEBHOOK_URL=https://your-public-host.example.com/webhooks/messaging
PORT=5000
TELNYX_PUBLIC_KEY=your_telnyx_ed25519_public_key_base64
