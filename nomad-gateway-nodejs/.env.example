# Telnyx API key — get yours at https://portal.telnyx.com
TELNYX_API_KEY=KEYyour-api-key-here

# Phone number (same number for SMS + Voice, E.164 format)
PHONE_NUMBER=+1XXXXXXXXXX

# SMS Messaging Profile ID (from Telnyx Portal)
SMS_MESSAGING_PROFILE_ID=your-messaging-profile-id-here

# Voice Connection ID (Call Control v2, from Telnyx Portal)
VOICE_CONNECTION_ID=your-voice-connection-id-here

# AI model for Telnyx inference
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Kiwix server (offline Wikipedia) — leave blank if not running locally
KIWIX_HOST=http://localhost:8080

# Ollama server (offline AI) — leave blank if not running locally
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenStreetMap Nominatim (default: public instance)
# MAPS_HOST=https://nominatim.openstreetmap.org

# App settings
PORT=3000

# Edge SQL database (only for Telnyx Edge deployment)
# SQLDB_ID=your-sqldb-id-here
