# Telnyx API key \u2014 used only in live mode (DEMO_MODE=false) for the
# scheduled-events REST calls. Never commit a real key.
TELNYX_API_KEY=your_telnyx_api_key_here

# The AI Assistant that answers the clinic line and runs the
# post-conversation wrap-up turn (post_conversation_settings.enabled = true).
TELNYX_ASSISTANT_ID=your_assistant_id_here

# The clinic's outbound caller ID (E.164). Also the default agent target.
TELNYX_FROM_NUMBER=+1555XXXXXXXX

# Shown to the patient in the confirmation SMS and in dynamic_variables.
CLINIC_NAME=Northside Imaging

# Safe demo mode: true = log the scheduled-event calls instead of placing them.
DEMO_MODE=true

# Delay (seconds) before the durable sweep timer re-checks a pending event create.
DIARY_SWEEP_SECONDS=120
