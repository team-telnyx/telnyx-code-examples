# Telnyx API credentials
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Telnyx phone number for SMS notifications
TELNYX_FROM_NUMBER=+15551234567

# Server configuration
PORT=5000

# Database configuration (for production use)
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# CloudFS configuration (for production use)
# CLOUDFS_BUCKET=your_bucket_name
