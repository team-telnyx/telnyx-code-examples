# Telnyx API key — authenticates the telnyx-edge CLI. The sample's actors use
# the zero-credential [telnyx] binding for inference, so this key is never read
# by the code itself.
TELNYX_API_KEY=your_telnyx_api_key_here

# Inference model used by the debaters in live mode (DEMO_MODE=false).
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# false → live inference via the TELNYX binding; true (default) → canned demo arguments.
DEMO_MODE=true

# Base URL the smoke test runs against (local edge stack via `npm start`).
DEMO_BASE_URL=http://localhost:8787
