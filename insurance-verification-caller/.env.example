# Telnyx API Key (never commit real keys)
TELNYX_API_KEY=your_telnyx_api_key_here

# Carrier IVR number to dial (demo: mock carrier number)
CARRIER_E164=+1555XXXXXXXX
MOCK_CARRIER_E164=+1555XXXXXXXX

# Telnyx number resource for outbound dial (connection_id)
CARRIER_NUMBER_ID=<carrier_number_id>

# Outbound caller ID (Telnyx number ID)
OUTBOUND_CALLER_ID=<outbound_caller_id>

# Front desk SMS destination
FRONTDESK_E164=+1555XXXXXXXX

# Detection thresholds
HOLD_MAX_MS=180000
ANSWER_SILENCE_MS=4000
VM_KEYWORDS=voicemail,leave a message,after the tone
MENU_LOOP_MAX=3
MAX_ATTEMPTS=3

# Jev Decision Models
JEV_MODEL=telnyx/decision-flash
JEV_ENDPOINT=https://api.telnyx.com/v2/ai/typesafe/v1/systemone

# Demo mode: true = no real calls/SMS, false = live mode
DEMO_MODE=true
</arg_value>
