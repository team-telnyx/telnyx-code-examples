# Structured-Insights Pipeline Desk \u2014 environment variables.
# Copy to .env and fill in real values. Never commit .env.

# Required \u2014 Telnyx API key used for every REST call.
TELNYX_API_KEY=your_telnyx_api_key_here

# Required \u2014 the number already associated with the assistant in the Telnyx
# portal. place_call.py errors with an actionable message if unset.
ASSISTANT_PHONE_NUMBER=+1555YYYYYYY

# Required \u2014 the number the demo call dials.
DESTINATION_NUMBER=+1555XXXXXXX

# Optional \u2014 if unset, wire_assistant.py creates an assistant with
# platform-default model/voice and the demo-scenario system prompt.
ASSISTANT_ID=

# Optional \u2014 registered into template and group `webhook` fields. When absent
# the demo runs end-to-end via the poll fallback.
PUBLIC_WEBHOOK_BASE_URL=

# Required by webhook_receiver.py \u2014 Telnyx public key for Ed25519 signature
# verification. The receiver refuses to start without it.
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Safe demo mode. true (default) logs the scheduled-event payload instead of
# placing a real call. Set false for live mode.
DEMO_MODE=true

# Optional \u2014 override only for non-production testing.
TELNYX_API_BASE=https://api.telnyx.com/v2
