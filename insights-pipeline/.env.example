# Telnyx credentials
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=

# Assistant wiring
ASSISTANT_ID=
# Leave empty until you have a real number associated with the assistant.
# A live run with these unset (or still the placeholder) fails loudly.
ASSISTANT_PHONE_NUMBER=
DESTINATION_NUMBER=

# Webhook receiver
PUBLIC_WEBHOOK_BASE_URL=
PORT=8000

# Safe demo mode (true = no real calls placed)
DEMO_MODE=true

# Local conversation store
CONVERSATIONS_STORE=conversations.json
