# Telnyx credentials
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here
TELNYX_API_BASE=https://api.telnyx.com/v2

# Assistant wiring (filled in by wire_assistant.py)
ASSISTANT_ID=
ASSISTANT_PHONE_NUMBER=+1555XXXXXXXX

# Demo call target (the caller's number)
DESTINATION_NUMBER=+1555XXXXXXXX

# Insight group (filled in by create_group.py)
INSIGHT_GROUP_ID=
INSIGHT_TEMPLATE_IDS=

# Public webhook base URL (ngrok http 8000)
PUBLIC_WEBHOOK_BASE_URL=

# Local JSON-lines store for conversation ids
CONVERSATIONS_STORE=conversations.json

# Safe demo mode - no real calls placed unless set to false
DEMO_MODE=true
