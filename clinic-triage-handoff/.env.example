# Every value the deployed instance needs. Push via: telnyx-edge secrets add <NAME> <value>
# (telnyx.toml [env_vars] does not propagate on Edge deploys — secrets do.)

# Call Control application that owns the phone lines (needs an outbound voice profile)
CONNECTION_ID=3065xxxxxxxxxxxxxxxx

# This function's public webhook URL (used for the nurse dial's per-leg webhook)
WEBHOOK_URL=https://your-function.your-subdomain.telnyxcompute.com/webhooks/voice

# assistant_id per phone line, JSON. The Edge function routes each line to its persona.
ASSISTANT_ROUTES_JSON={" clinic_line_e164": "assistant-xxxx", "billing_desk_e164": "assistant-yyyy", "clinical_desk_e164": "assistant-zzzz"}

# Who gets the escalation SMS (the on-call nurse)
ONCALL_NUMBER=+15557000000

# The SMS sender — must be a 10DLC-registered number, or carriers drop the message silently
SMS_FROM_NUMBER=+15557000001

# Voice personas (Telnyx TTS voices)
CLINIC_VOICE=Telnyx_Katie
SPECIALIST_VOICE=Telnyx_FLORA

# Telnyx API key (used by the Edge runtime binding and the REST helpers)
TELNYX_API_KEY=KEY0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
