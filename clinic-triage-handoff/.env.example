# Telnyx API key — also injected at runtime via `telnyx-edge secrets add TELNYX_API_KEY "<key>"`
TELNYX_API_KEY=your_telnyx_api_key_here

# OpenAI-compatible model used for intent classification and one-line summarization.
AI_MODEL=gpt-4o-mini

# Telnyx Call Control application / connection ID used to originate the warm-dial leg
# back to the specialist's phone. Set via `telnyx-edge secrets add CONNECTION_ID "<id>"`
# at deploy time. On Edge, process.env.CONNECTION_ID is populated from Edge secrets
# (the [env_vars] block in telnyx.toml is ignored by this runtime).
CONNECTION_ID=

# Public webhook URL for the function — voice webhooks land on /webhooks/voice.
# Must be reachable by Telnyx. Set via `telnyx-edge secrets add WEBHOOK_URL "<url>"`.
WEBHOOK_URL=

# Voices used by gather_using_speak / gather_using_ai. Defaults shown below.
CLINIC_VOICE=Telnyx_Katie
SPECIALIST_VOICE=Telnyx_FLORA

# Inbound line used to seed the status page router instance. Set via Edge secrets
# (or just leave blank to fall back to the literal "clinic-triage-status" seed).
STATUS_PAGE_LINE=

# JSON map of inbound phone line (E.164) → Telnyx AI Assistant ID. Each clinic
# phone line answers with its own persona: the receptionist uses the native
# transfer tool with warm-transfer acceptance, and the billing / clinical
# desk personas receive pre-classified callers. Example:
#
#   {
#     "+15550000001": "assistant-<uuid-receptionist>",
#     "+15550000002": "assistant-<uuid-billing-desk>",
#     "+15550000003": "assistant-<uuid-clinical-desk>"
#   }
ASSISTANT_ROUTES_JSON=

# JSON map of desk line (E.164) → desk line (E.164) to dial when the desk's
# assistant fires its `flag_misroute` tool. Example for a two-desk clinic:
#
#   {
#     "+15550000002": "+15550000003",
#     "+15550000003": "+15550000002"
#   }
#
# If a desk is missing from this map, the misroute webhook is acknowledged
# but no transfer is executed (the caller stays on the desk line).
MISROUTE_TARGETS_JSON=
