# Telnyx API key used to create and mount CloudFS. The application does not read it.
TELNYX_API_KEY=your_telnyx_api_key_here

# Absolute path where the same Telnyx CloudFS filesystem is mounted for every agent process.
CLOUDFS_MOUNT_PATH=/mnt/agentfs

# Optional shared directory inside the mount. Defaults to /shared.
CLOUDFS_WORKSPACE_DIR=/shared
