# Telnyx credentials — never commit real values
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# AI Assistant attached to the meeting session (by id only)
TELNYX_ASSISTANT_ID=your_assistant_id_here

# Public URL Telnyx will POST webhooks to
WEBHOOK_URL=https://your-domain.example.com/webhooks/telnyx

# Safe demo mode — no real meeting bot is launched when true
DEMO_MODE=true

# Port for the FastAPI webhook receiver
PORT=5000
