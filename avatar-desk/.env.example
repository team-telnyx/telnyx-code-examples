# Telnyx API credentials — never commit real values.
TELNYX_API_KEY=your_telnyx_api_key_here

# Safe demo mode: true = validate + log only, no real uploads or WebSocket.
DEMO_MODE=true

# Assistant configuration
ASSISTANT_NAME=Avatar Desk Assistant
ASSISTANT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
ASSISTANT_INSTRUCTIONS=You are a friendly restaurant host. Keep replies short and spoken.
# Telnyx TTS only — third-party TTS (e.g. ElevenLabs) is NOT supported with avatars.
TELNYX_TTS_VOICE=Telnyx.KokoroTTS.af

# Populated after running the create-avatar / wire-assistant steps.
AVATAR_ID=
ASSISTANT_ID=

PORT=5000
