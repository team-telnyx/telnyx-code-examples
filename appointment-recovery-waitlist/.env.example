# Copy to .env for local tooling (never commit .env).
# All of these ship as [[secrets]] bindings in telnyx.toml for Edge deploys:
#   telnyx-edge secrets add <NAME> <value>

TELNYX_API_KEY=your_telnyx_api_key_here

# Call Control: dial the missed patient and waitlist candidates (live mode).
OUTBOUND_CONNECTION_ID=your_call_control_connection_id_here
OUTBOUND_CALLER_ID=+15551234567

# SMS-capable clinic number used for outreach, confirmations, and replies.
SCHEDULING_SMS_E164=+15551234568

# Recovery workflow tuning (ticket defaults shown).
WAITLIST_REPLY_TIMEOUT_MIN=10
OUTREACH_RETRY_MAX=2
SLOT_EXPIRY_MIN=60
CLINIC_TIMEZONE=America/New_York

# "true" (default) = deterministic demo: calls/SMS are logged, patient replies
# are driven via /demo/reply and /demo/call-event. "false" = real calls/SMS;
# inbound webhooks are signature-verified against TELNYX_PUBLIC_KEY.
DEMO_MODE=true
TELNYX_PUBLIC_KEY=your_base64_public_key_here
