# Telnyx account API key (management plane). NEVER commit a real key.
TELNYX_API_KEY=your_telnyx_api_key_here

# AI Gateway endpoints (defaults shown; override only if instructed)
TELNYX_MGMT_BASE=https://api.telnyx.com/v2/llm_token_gateway
TELNYX_INFER_BASE=https://llm.telnyx.com/v1

# Models
PRIMARY_MODEL=Kimi-K3
FALLBACK_MODEL=GLM-5.3-Flash

# Safe demo mode — no real spend unless explicitly disabled
DEMO_MODE=true

# Shared-secret guard for the Flask layer (X-Demo-Auth header).
# Demo-grade only — do not expose this service to untrusted networks.
DEMO_AUTH_TOKEN=local-dev-only

# Where the token secret is written (0600). Never committed.
TOKEN_SECRET_FILE=.token_secret

# Flask
PORT=8080
