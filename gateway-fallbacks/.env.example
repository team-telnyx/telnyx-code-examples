# Telnyx account API key (management plane). NEVER commit a real key.
# https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=your_telnyx_api_key_here

# Models that make up the fallback chain (must be valid Telnyx-hosted aliases;
# check with `python inference.py` after provisioning, or the model list in the docs).
PRIMARY_MODEL=Kimi-K3
FALLBACK_MODEL=GLM-5.3-Flash

# Exported by hand after `python provision.py` prints the token secret exactly
# once. The secret is never written to disk, so every later step reads it here.
GATEWAY_TOKEN_KEY=

# Optional overrides for the spend ledger window (half-open UTC [start, end)).
# Defaults to [today, tomorrow).
START_DATE=
END_DATE=
