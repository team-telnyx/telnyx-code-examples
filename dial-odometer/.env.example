# Telnyx API key used for GET /v2/dial_metrics (live mode only).
TELNYX_API_KEY=your_telnyx_api_key_here

# Poll cadence in seconds for the actor's schedule() loop.
POLL_EVERY=60

# Warn (and throttle) when live DPS reaches this percentage of dps_limit.
WARN_PCT=80

# Safe demo mode: synthesizes dial metrics instead of calling Telnyx.
# Set to "false" to hit the real Dial Metrics API with TELNYX_API_KEY.
DEMO_MODE=true
