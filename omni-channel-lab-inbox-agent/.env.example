# Telnyx credentials — never commit real values
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# v1 — voice channel
FROM_NUMBER=+15551234567
TEXML_APP_ID=replace_with_your_texml_app_id
VOICE_ASSISTANT_ID=replace_with_your_voice_assistant_id

# v1 — fax channel
FAX_NUMBER=+15551234568
FAX_APP_ID=replace_with_your_fax_app_id

# v1 — admin UI auth (shared token; replace with a strong random string)
ADMIN_TOKEN=replace_with_a_random_admin_token

# v1 — AI Inference + TTS (zero-credential via the [telnyx] binding)
AI_MODEL=zai-org/GLM-5.2
TTS_VOICE=Telnyx.Ultra.f786b574-daa5-4673-aa0c-cbe3e8534c02

# local dev only — skip webhook signature verification
DEMO_MODE=true

# v1 — email channel (Telnyx Email API)
EMAIL_FROM=lab-results@yourdomain.com
TELNYX_EMAIL_INBOX_ID=replace_with_your_email_inbox_id

# demo — stand-in patient for the simulated appointment flow
DEMO_PATIENT_EMAIL=patient@example.com
DEMO_PATIENT_PHONE=+15551234567
DEMO_PATIENT_NAME=Jane
