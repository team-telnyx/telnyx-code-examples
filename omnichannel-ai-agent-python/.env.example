# Telnyx API credentials
TELNYX_API_KEY=your_telnyx_api_key_here

# Claude API credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telnyx phone number (used for SMS and Voice)
TELNYX_FROM_NUMBER=+15551234567

# Verified sender email address
TELNYX_EMAIL_FROM=agent@yourdomain.com

# Messaging Profile ID (optional)
MESSAGING_PROFILE_ID=

# Call Control Application connection ID
CONNECTION_ID=your_connection_id_here

# Server configuration
PORT=5000

# Database path (SQLite)
DB_PATH=conversations.db
