# Telnyx Edge Compute credentials (used by the telnyx-edge CLI, not by Flask).
# Set the real value locally with: telnyx-edge auth api-key set <KEY>
TELNYX_API_KEY=your_telnyx_api_key_here

# Path to the telnyx-edge CLI binary.
TELNYX_EDGE_BIN=telnyx-edge

# Container image used when creating a CPU sandbox.
SANDBOX_IMAGE=python:3.12-slim

# Safe demo mode: true = simulate every CLI call, false = hit the real control plane.
DEMO_MODE=true

# Per-command CLI timeout, in seconds.
CLI_TIMEOUT_SECONDS=120

# Maximum size of a file transferred in or out of the sandbox, in bytes.
MAX_FILE_BYTES=1048576

# Port the Flask dev server binds to.
FLASK_PORT=5000
