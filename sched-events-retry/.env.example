# Telnyx credentials — never commit real values
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_ASSISTANT_ID=your_assistant_id_here
TELNYX_FROM_NUMBER=+1555XXXXXXXX
TELNYX_SIP_REGION=us-east

# Campaign configuration
CAMPAIGN_ID=campaign-demo
DEMO_MODE=true
PORT=5000
STATE_DIR=.campaign_state

# Live-mode safety gate (ignored while DEMO_MODE=true)
# CONFIRM_LIVE_CALLS must be true before any real outbound call is placed.
CONFIRM_LIVE_CALLS=false
