# Telnyx credentials — never commit real values
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_ASSISTANT_ID=your_assistant_id_here
TELNYX_FROM_NUMBER=+1555XXXXXXXX
TELNYX_SIP_REGION=us-east

# Optional API base override (defaults to https://api.telnyx.com/v2)
TELNYX_API_BASE=https://api.telnyx.com/v2

# Safe demo mode: true = print payloads, no real calls dispatched
DEMO_MODE=true
