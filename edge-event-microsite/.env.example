# Required — Telnyx API key (also injected automatically by the [telnyx] binding at ship time)
TELNYX_API_KEY=your_telnyx_api_key_here

# Required — org public key for Ed25519 webhook verification (secrets.add at deploy)
# Fetch with: curl -H "Authorization: Bearer $TELNYX_API_KEY" https://api.telnyx.com/v2/public_key
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Optional overrides (defaults live in telnyx.toml [env_vars])
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct
TRANSCRIBE_MODEL=distil-whisper/distil-large-v2
TELNYX_SMS_FROM=+1555XXXXXXX
TELNYX_WHATSAPP_FROM=+1555XXXXXXX
TELNYX_SALES_REP_PHONE=+1555XXXXXXX
EMAIL_FROM=onboarding@mail.telnyx.com
# Where hot-lead email fallbacks + sponsor reports go (account owner email
# works with the shared sending domain):
EMAIL_TO=you@example.com
