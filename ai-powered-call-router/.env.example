# Telnyx API key — used for Call Control REST (answer, speak, gather_using_ai, transfer)
# Get it from https://portal.telnyx.com/api-keys
TELNYX_API_KEY=your_telnyx_api_key_here

# LLM model for intent classification (Telnyx-hosted, no OpenAI key needed)
# List available Telnyx-hosted models: client.ai.openai.list_models() with owned_by == 'Telnyx'
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Fallback transfer destination if the KV route table has no entry for the classified intent (E.164)
DEFAULT_DESTINATION=+17177247292

# KV namespace ID for the route table
# Create with: telnyx-edge storage kv create --name ai-call-router-routes
# Paste the returned id here AND in telnyx.toml [storage.kv.ROUTES]
KV_NAMESPACE_ID=your_kv_namespace_id_here
