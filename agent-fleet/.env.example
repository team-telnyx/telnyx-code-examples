# Telnyx credentials \u2014 placeholders only, never commit real values.
# Set with: telnyx-edge secrets add TELNYX_API_KEY "<key>"
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_webhook_public_key_here

# Telnyx Inference model id (list them with `telnyx-acp models`).
# The default needs no provider key; `openai/*` ids need your own key as a secret.
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Safe demo mode. Anything other than "false" means no SMS is sent.
DEMO_MODE=true

# The scheduling agent's number in E.164. Placeholder only.
AGENT_NUMBER=+1555XXXXXXXX

# KV namespace for FLEET_KV (mirror this into telnyx.toml).
FLEET_KV_NAMESPACE_ID=<kv-namespace-uuid>
