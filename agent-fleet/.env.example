# Telnyx credentials — placeholders only, never commit real values.
# Used by telnyx-acp when `telnyx-acp login` is unavailable (scripts/CI).
TELNYX_API_KEY=your_telnyx_api_key_here

# The account's webhook public key. `telnyx-acp deploy` reads it from the
# account automatically and stores it as the TELNYX_PUBLIC_KEY secret —
# you normally never set this by hand.
# TELNYX_PUBLIC_KEY=your_telnyx_public_key_here
