# Telnyx API key — REQUIRED to fetch the Ed25519 public key for webhook signature verification.
# NOT used for LLM inference (the Edge binding is pre-authenticated).
TELNYX_API_KEY=your_telnyx_api_key_here

# Optional: override the default model. Provisional — must be a model the binding serves.
# Docs-indicated default: zai-org/GLM-5.2
MODEL=zai-org/GLM-5.2

# Demo mode: "true" serves a local HTML test UI at /; "false" disables it.
DEMO_MODE=true

# SMS transport: "demo" simulates outbound SMS in the event log; "production" sends real SMS via the binding.
SMS_TRANSPORT=demo

# Numbers used by the demo UI (E.164).
# DEMO_FROM_NUMBER is the agent's number (the customer's To: address).
# DEMO_SENDER_NUMBER is the simulated customer's phone (the actor's identity).
DEMO_FROM_NUMBER=+16282564467
DEMO_SENDER_NUMBER=+14157986793

# Demo customer identity seeded into the actor's durable CustomerState.
# In Gate 1 the demo customer is "Anusha" with a mock salesforce_id.
# Mock salesforce is on by default — real Salesforce credentials only arrive in Gate 4.
DEMO_CUSTOMER_NAME=Anusha
DEMO_CUSTOMER_SALESFORCE_ID=mock-anusha-salesforce-id
USE_MOCK_SALESFORCE=true

# Optional real Salesforce OAuth2 client credentials. Leave mock mode enabled
# until local graph and SMS flows are working.
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret
SF_DOMAIN=login
SF_API_VERSION=v58.0
