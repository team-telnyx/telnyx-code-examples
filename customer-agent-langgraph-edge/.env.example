# Telnyx API key — REQUIRED to fetch the Ed25519 public key for webhook signature verification.
# NOT used for LLM inference (the Edge binding is pre-authenticated).
TELNYX_API_KEY=your_telnyx_api_key_here

# Optional: override the default model. Must be a model the binding serves.
MODEL=zai-org/GLM-5.2

# Demo mode: "true" serves a local HTML test UI at /; "false" disables it.
DEMO_MODE=true

# SMS transport: "demo" simulates outbound SMS in the event log; "production" sends real SMS via the binding.
SMS_TRANSPORT=demo

# Numbers used by the demo (E.164).
# DEMO_FROM_NUMBER is the agent's number (the number callers dial).
# DEMO_SENDER_NUMBER is the simulated customer's phone (the actor's identity).
DEMO_FROM_NUMBER=+15551234567
DEMO_SENDER_NUMBER=+15557654321

# Demo customer identity seeded into the actor's durable CustomerState.
DEMO_CUSTOMER_NAME=Jane
DEMO_CUSTOMER_SALESFORCE_ID=mock-demo-salesforce-id
USE_MOCK_SALESFORCE=true

# Optional real Salesforce OAuth2 client credentials. Leave mock mode enabled
# until you're ready to connect your Salesforce org.
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret
SF_DOMAIN=login
SF_API_VERSION=v58.0

# SDR confirmation email recipient (for the AgentMail loop).
# In production, set to your SDR's real email. For demo, use your test email.
SDR_EMAIL=sdr@example.com
SDR_NAME=Steve

# AgentMail credentials (for the SDR confirmation email loop).
AGENTMAIL_API_KEY=your_agentmail_api_key_here
AGENTMAIL_INBOX=your-agent@agentmail.to
AGENTMAIL_WEBHOOK_SECRET=your_agentmail_webhook_secret_here
