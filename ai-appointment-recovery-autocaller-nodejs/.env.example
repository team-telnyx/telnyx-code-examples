# Telnyx API key (Mission Control portal)
TELNYX_API_KEY=YOUR_TELNYX_API_KEY

# Call Control connection that places the AI call (create in Mission Control → Voice → Programmable)
TELNYX_CONNECTION_ID=YOUR_CALL_CONTROL_CONNECTION_ID

# The clinic's outbound number (E.164) — shown as caller ID
TELNYX_NUMBER=+15551234567

# Public URL of this server (ngrok / Cloudflare tunnel / deployed URL)
PUBLIC_BASE_URL=https://your-public-host.example

# Optional: reuse an existing AI Assistant (leave empty to bootstrap one by name)
TELNYX_ASSISTANT_ID=

# Optional: Ed25519 webhook signature verification (org key from GET /v2/public_key)
TELNYX_PUBLIC_KEY=

# Optional
CLINIC_NAME=Winderval Medical
PORT=3000
