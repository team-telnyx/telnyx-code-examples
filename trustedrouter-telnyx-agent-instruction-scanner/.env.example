# Required - TrustedRouter API key. This demo never calls the Telnyx API
# directly; inference reaches Telnyx-hosted GLM 5.3 Flash through TrustedRouter's
# Telnyx-only routing. Get a key at https://trustedrouter.com
TRUSTEDROUTER_API_KEY=replace_me

# Optional - total character budget submitted for inference (default: 200000).
# MAX_TOTAL_CHARS=200000

# NOTE: TELNYX_API_KEY is NOT needed for this demo. This placeholder is kept only
# to satisfy this repository's .env.example convention; leave it unset.
TELNYX_API_KEY=your_telnyx_api_key_here
