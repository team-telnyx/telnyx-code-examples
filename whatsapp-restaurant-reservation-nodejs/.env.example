# Telnyx — main account (AI Inference, Number Lookup)
TELNYX_API_KEY=KEYyour-main-api-key-here

# Telnyx — WABA-enabled account (WhatsApp messaging)
TELNYX_WHATSAPP_API_KEY=KEYyour-whatsapp-api-key-here
WHATSAPP_NUMBER=+1XXXXXXXXXX
WHATSAPP_MESSAGING_PROFILE_ID=your-messaging-profile-id-here

# AI model for inference
AI_MODEL=zai-org/GLM-5.3-Flash

# Google Places API (restaurant search)
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# App settings
DEFAULT_CITY=Amsterdam
PORT=3000

# Edge SQL database (only for Telnyx Edge deployment)
# SQLDB_ID=your-sqldb-id-here
