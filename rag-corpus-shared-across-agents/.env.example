# Telnyx Inference and Cloud Storage run through pre-authenticated platform
# bindings on Telnyx Edge Compute — no API key is needed for deployed
# functions. A key is only required for LOCAL development (scripts/local-dev.ts
# reconstructs the Telnyx client with it).
TELNYX_API_KEY=your_telnyx_api_key_here

# Chat model used by every persona agent (OpenAI-compatible completions)
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Embedding model used by the corpus agent
EMBEDDING_MODEL=thenlper/gte-large

# Cloud Storage bucket scanned by POST /api/corpus/<id>/ingest-bucket
KNOWLEDGE_BUCKET=replace-with-your-bucket
KNOWLEDGE_PREFIX=knowledge/

# Retrieval + chunking knobs
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Local dev server
PORT=8787
