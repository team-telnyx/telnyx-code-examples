# Telnyx API credentials
TELNYX_API_KEY=your_telnyx_api_key_here

# Telnyx Ed25519 public key for webhook signature verification
# Found in: Telnyx Portal → Mission Control → Public Key
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Telnyx Call Control Connection ID (SIP Connection)
# Found in: Telnyx Portal → Mission Control → SIP Connections
TELNYX_CONNECTION_ID=your_connection_id_here

# Default transfer number when IVR cannot route the call
DEFAULT_TRANSFER_NUMBER=+18005551234

# Flask configuration
PORT=5000
FLASK_DEBUG=false
