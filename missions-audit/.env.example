# Telnyx credentials — never commit real values.
TELNYX_API_KEY=your_telnyx_api_key_here

# Telnyx API base. Override only for a non-production environment.
TELNYX_API_BASE=https://api.telnyx.com/v2

# Demo mode (default true): the worker walks the full missions ledger but
# creates no assistant and places no call. Set to false for live mode.
DEMO_MODE=true

# Live mode only: the number the outreach call is placed to (E.164).
DESTINATION_NUMBER=

# Live mode only: a phone number associated with the assistant in the
# Telnyx Portal (AI > Assistants > Phone Numbers). Used as
# telnyx_agent_target on the scheduled event.
ASSISTANT_PHONE_NUMBER=

# Optional: reuse an existing assistant instead of creating one (live mode).
# ASSISTANT_ID=

# Filled in by the workflow scripts as you go (create_mission.py / start_run.py).
# MISSION_ID=
# RUN_ID=
