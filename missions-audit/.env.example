# Telnyx credentials — never commit real values
TELNYX_API_KEY=your_telnyx_api_key_here

# Safe demo mode: no real calls placed when true
DEMO_MODE=true

# Destination phone number for the outreach call (placeholder format)
DESTINATION_NUMBER=+1555XXXXXXXX

# Phone number associated with the assistant in the Telnyx portal (required for live mode)
ASSISTANT_PHONE_NUMBER=+1555XXXXXXXX

# Optional: reuse an existing assistant instead of creating one
ASSISTANT_ID=

# Worker polling configuration
POLL_INTERVAL_SECONDS=5
POLL_TIMEOUT_SECONDS=600

# Flask
PORT=5000
