# Telnyx credentials — never commit real values.
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_API_BASE=https://api.telnyx.com/v2

# Safe demo mode: true = log what would happen, false = place the real call.
DEMO_MODE=true

# Destination for the outreach call (placeholder format only).
DESTINATION_NUMBER=+1555XXXXXXXX

# Phone number associated with the assistant in the Telnyx Portal.
ASSISTANT_PHONE_NUMBER=+1555XXXXXXXX

# Optional: reuse an existing assistant instead of creating one.
# ASSISTANT_ID=

# Filled in by the workflow scripts as you go.
# MISSION_ID=
# RUN_ID=
