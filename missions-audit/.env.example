# Telnyx API credentials — never commit real values.
TELNYX_API_KEY=your_telnyx_api_key_here

# Safe demo mode: no real calls placed when true. Pass --live to execute.py
# to override this for a single run.
DEMO_MODE=true

# Mission workflow identifiers (populated as you run each step).
MISSION_ID=
RUN_ID=
STEP_IDS=
ASSISTANT_ID=

# Destination phone number for the outreach call. Must be valid E.164
# (e.g. +15551234567) — validated before any live API call.
DESTINATION_NUMBER=+15551234567

# Phone number associated with your assistant in the Telnyx Portal.
# Must be valid E.164 (e.g. +15559876543).
ASSISTANT_PHONE_NUMBER=+15559876543
