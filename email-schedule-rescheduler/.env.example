```
# Telnyx API key (required for live mode)
TELNYX_API_KEY=your_telnyx_api_key_here

# Sender and recipient email addresses
TELNYX_EMAIL_FROM=your_sender_email@example.com
TELNYX_EMAIL_TO=your_recipient_email@example.com

# Demo mode: true (default) prints requests without hitting the API.
# Set to false to run against the live Telnyx API.
DEMO_MODE=true
```
