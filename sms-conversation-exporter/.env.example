# Telnyx API credentials — only needed for local development.
# Deployed functions authenticate via the [telnyx] binding in telnyx.toml.
TELNYX_API_KEY=your_telnyx_api_key_here

# Public key for verifying inbound webhook signatures
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Ops SMS alerting
ALERT_PHONE=+18005551234
SENDER_PHONE=+18005551234

# Export chunk size (messages per Cloud Storage object)
CHUNK_SIZE=500
