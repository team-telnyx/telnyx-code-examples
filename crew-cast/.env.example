# --- Telnyx credentials (live mode only; the TELNYX binding injects auth at deploy) ---
TELNYX_API_KEY=your_telnyx_api_key_here
# Ed25519 public key used to verify inbound webhook signatures.
TELNYX_PUBLIC_KEY=your_telnyx_webhook_public_key_here

# --- Demo mode ---
# true  = no real SMS is sent (default, safe)
# false = live sends via the TELNYX binding
DEMO_MODE=true

# --- Crew thread ---
# The Telnyx number that owns the group thread (MMS-capable, v2 webhooks enabled).
CREW_FROM=+1555XXXXXXXX
# Messaging profile attached to CREW_FROM (MMS enabled + v2 webhook version).
CREW_PROFILE_ID=your_messaging_profile_id_here
# Where the "all accounted for" 1:1 SMS goes.
DISPATCH_PHONE=+1555XXXXXXXX
# Public base URL of this worker (used to build the webhook URL).
PUBLIC_BASE_URL=https://your-worker.example.workers.dev

# --- Demo roster (used when POST /cast omits "recipients") ---
CREW_TO_1=+1555XXXXXXX1
CREW_TO_2=+1555XXXXXXX2
CREW_TO_3=+1555XXXXXXX3
CREW_TO_4=+1555XXXXXXX4
CREW_TO_5=+1555XXXXXXX5
CREW_TO_6=+1555XXXXXXX6
