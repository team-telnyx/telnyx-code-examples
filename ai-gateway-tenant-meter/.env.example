TELNYX_API_KEY=your_telnyx_api_key_here

# Ops SMS recipient (your phone) and Telnyx messaging number to send from
ADMIN_SMS_TO=+1555XXXXXXXX
ADMIN_SMS_FROM=+1555XXXXXXXX

# Set to false to send real SMS through the Telnyx binding
DEMO_MODE=true

# Optional bearer token guarding /provision and /spend
API_TOKEN=your_shared_api_token_here
ROLLUP_INTERVAL_SECONDS=3600
WARN_PCT=80
HARD_PCT=100
