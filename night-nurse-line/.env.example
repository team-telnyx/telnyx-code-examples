# Telnyx API credentials \u2014 never commit real values.
TELNYX_API_KEY=your_telnyx_api_key_here
# Base64 Ed25519 public key from the Telnyx portal (used to verify /sms webhooks).
TELNYX_PUBLIC_KEY=your_telnyx_webhook_public_key_here

# Assistant created by scripts/setup_assistant.sh (must end replies with TRIAGE: ...).
NIGHT_NURSE_ASSISTANT_ID=your_assistant_id_here

# E.164 placeholders only \u2014 never commit real phone numbers.
FROM_E164=+1555XXXXXXX
ONCALL_E164=+1555XXXXXXX
DAY_TEAM_E164=+1555XXXXXXX

# Safe demo mode: true = SMS is logged, never sent. Set to false for live sends.
DEMO_MODE=true
