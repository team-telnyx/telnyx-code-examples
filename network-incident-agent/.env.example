# Used by Call Control webhook actions and telnyx-edge provisioning.
TELNYX_API_KEY=your_telnyx_api_key_here

# An SMS-capable Telnyx number in E.164 format.
TELNYX_SMS_FROM_NUMBER=+15555550100

# Telnyx KV namespace configured in telnyx.toml.
INCIDENT_KV_NAMESPACE_ID=your_kv_namespace_uuid_here

# The same CloudFS filesystem must be mounted into every actor process.
CLOUDFS_MOUNT_PATH=/mnt/incidentfs
CLOUDFS_RCA_DIR=/rca

# Three days in production. Set to 30 for a recording demo.
RECURRENCE_CHECK_SECONDS=259200

# Optional CLI override.
TELNYX_EDGE_BIN=/absolute/path/to/telnyx-edge
TELNYX_EDGE_PORT=8787
