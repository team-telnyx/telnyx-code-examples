# Telnyx API credentials — replace with your own values
TELNYX_API_KEY=your_telnyx_api_key_here

# These are set as [env_vars] in telnyx.toml for the deployed function;
# copy them here if you want to override locally or via `telnyx-edge secrets`.
# AI_MODEL — Telnyx-hosted inference model used for prompts + summaries
AI_MODEL=zai-org/GLM-5.2
# SMS_FROM — Telnyx number the summary SMS is sent from (E.164)
SMS_FROM=+1555XXXXXXXX
# SMS_TO — recipient of the post-conference summary SMS (E.164)
SMS_TO=+1555XXXXXXXX
# DEMO_MODE — true = no live Call Control / SMS side effects, false = live
DEMO_MODE=true
