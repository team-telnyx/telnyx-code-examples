# Telnyx API key (used for live-mode transcription + SMS)
TELNYX_API_KEY=your_telnyx_api_key_here

# Operator phone number for SMS notifications (live mode only)
OPERATOR_NUMBER=+1555XXXXXXXX

# Telnyx sender number (live mode only)
TELNYX_SENDER=+1555XXXXXXXX

# Demo mode: true (default) logs SMS and mocks transcription; false runs real transcription
DEMO_MODE=true

# Speech-to-text model for live transcription (Telnyx AI Audio Transcriptions API)
TRANSCRIPTION_MODEL=distil-whisper/distil-large-v2

# Comma-separated speech audio URLs (5 entries; short public-domain speech clips)
MOCK_AUDIO_URLS=https://upload.wikimedia.org/wikipedia/commons/b/bb/Neil_Armstrong_small_step.wav,https://upload.wikimedia.org/wikipedia/commons/6/6d/Address_to_the_Nation_Excerpt.ogg,https://upload.wikimedia.org/wikipedia/commons/4/40/Portion_of_a_speech_by_Harding.ogg,https://upload.wikimedia.org/wikipedia/commons/f/f7/Speech_Prosody_audio_example.wav,https://upload.wikimedia.org/wikipedia/commons/a/a5/Booker_T._Washington_reading_an_excerpt_from_his_1895_Atlanta_Compromise_speech.mp3

# Watchdog: children still RUNNING after this many seconds are marked FAILED and re-spawned
STUCK_TIMEOUT_SECONDS=300

# Max re-spawn attempts per file before it is left FAILED (honest scorecard)
MAX_CHILD_ATTEMPTS=3

# Per-file pacing in demo mode (0 = instant; ~2500 makes the console watchable)
DEMO_DELAY_MS=0

# Demo fault injection: comma-separated file ids (e.g. "file-2") whose workers
# crash mid-run, to demo stuck-child detection, re-spawn, and PARTIAL_FAILURE.
# Leave empty for a clean run. Demo mode only.
DEMO_HANG_FILES=
DEMO_HANG_MS=8000
