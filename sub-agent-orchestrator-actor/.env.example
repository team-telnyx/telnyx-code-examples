# Telnyx API key (used for live-mode LLM transcription)
TELNYX_API_KEY=your_telnyx_api_key_here

# Operator phone number for SMS notifications (live mode only)
OPERATOR_NUMBER=+1555XXXXXXXX

# Telnyx sender number (live mode only)
TELNYX_SENDER=+1555XXXXXXXX

# Demo mode: true (default) logs SMS instead of sending; false sends real SMS
DEMO_MODE=true

# Comma-separated public sample MP3 URLs (5 entries)
MOCK_AUDIO_URLS=https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3,https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3,https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3,https://www.soundhelix.com/examples/mp3/SoundHelix-Song-4.mp3,https://www.soundhelix.com/examples/mp3/SoundHelix-Song-5.mp3
