# Telnyx credentials — never commit real values
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_webhook_public_key_here
TELNYX_ENTERPRISE_ID=your_enterprise_id_here

# Safe demo mode: true = no real remediation submitted (default)
DEMO_MODE=true

# Polling interval (seconds) for the no-webhook fallback
POLL_INTERVAL_SECONDS=60

# SQLite path for the last-submission state (single-process demo artifact)
STATE_DB=remediation_state.db

# Flask port
PORT=5000
