# Telnyx credentials \u2014 never commit real values
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Enterprise resource root (registered once, shared with Branded Calling)
TELNYX_ENTERPRISE_ID=your_enterprise_id_here

# API base (override only for testing)
TELNYX_API_BASE=https://api.telnyx.com/v2

# Safe demo mode: true = no real remediation requests submitted
DEMO_MODE=true

# Webhook receiver port
PORT=5000
