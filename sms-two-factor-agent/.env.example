# Telnyx API credentials — used by the telnyx-edge CLI and tooling.
# The deployed Edge function gets credentials from the [telnyx] binding in
# telnyx.toml (zero-credential) — it does not read this file.
TELNYX_API_KEY=your_telnyx_api_key_here

# Telnyx number to send SMS from (E.164 format) — set as an [env_vars] entry
# in telnyx.toml for the deployed function.
TELNYX_FROM_NUMBER=+1555XXXXXXXX

# Demo mode toggle — set as an [env_vars] entry in telnyx.toml.
# "true"  (default) — logs SMS to the actor console, no real messages sent
# "false"           — sends real SMS via the [telnyx] binding
DEMO_MODE=true
