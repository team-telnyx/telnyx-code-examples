# Telnyx API credentials — get yours at https://portal.telnyx.com
TELNYX_API_KEY=KEY_your_telnyx_api_key_here

# Telnyx public key for webhook signature verification — find it in the
# portal under Account Settings > Keys & Credentials > Public Key
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# SMS-enabled Telnyx number that receives your texts and replies (E.164)
TELNYX_PHONE_NUMBER=+15555550100

# Your own mobile number (E.164). Only texts from this number can send the bot
# into a meeting; everything else is ignored.
OWNER_PHONE_NUMBER=+15555550123

# Name shown on the bot's tile in the meeting
BOT_NAME=Your Bot

# Optional: announce the bot in the meeting chat when it joins
CHAT_ON_ENTER=Hi all - I am a bot attending on behalf of a teammate who could not make it. I will take notes and they will get a TL;DR after.

# Optional: Telnyx AI Assistant ID so the bot can speak and answer questions in the meeting
# ASSISTANT_ID=assistant-your-assistant-id-here

# Optional: public HTTPS URL of a JPEG to show as the bot's camera tile
# CAMERA_IMAGE_URL=https://example.com/bot-camera.jpg

PORT=3000
