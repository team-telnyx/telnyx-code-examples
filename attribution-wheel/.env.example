# Telnyx API key — server-side only. Never commit a real key.
TELNYX_API_KEY=your_telnyx_api_key_here

# Demo mode (default true): no SMS is sent and no real inference traffic is generated.
# Set to false to page the on-call for real and pull live gateway spend.
# The ATTRIBUTION_ prefix keeps this sample's config from clashing with other
# samples sharing the account-level secret store.
ATTRIBUTION_DEMO_MODE=true

# On-call paging (live mode only). Placeholders — replace with real E.164 numbers.
ATTRIBUTION_ONCALL_E164=+1555XXXXXXXX
ATTRIBUTION_DEMO_NUMBER=+1555XXXXXXXX

# Attribution thresholds
ATTRIBUTION_ALERT_SHARE_PCT=40
ATTRIBUTION_SPIKE_MULTIPLE=2.0

# Model used by the tagged demo traffic against https://llm.telnyx.com/v1
# (also the only model allowed on the token group the actor creates)
AI_GATEWAY_MODEL=Kimi-K3

# Live-mode token keys for tagged traffic (echoed once by @rpc bootstrap()).
ATTRIBUTION_SUPPORT_TOKEN_KEY=
ATTRIBUTION_BILLING_TOKEN_KEY=
ATTRIBUTION_DOCS_TOKEN_KEY=

# The deployed actor's /rpc endpoint, e.g. https://attribution-wheel-<id>.telnyxcompute.com
ATTRIBUTION_ACTOR_URL=http://127.0.0.1:8787
