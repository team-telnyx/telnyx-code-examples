# Telnyx API key — get one from https://portal.telnyx.com
TELNYX_API_KEY=your_telnyx_api_key_here

# Deployed worker URL (printed by `telnyx-edge ship`) — used by `npm run bootstrap`
BASE_URL=https://your-worker.telnyxcompute.com

# Seed handbook URL (2-5 pages, plain text or HTML) — use one you control
SEED_HANDBOOK_URL=https://acme.example.com/handbook

# Bucket name (pre-created in the Telnyx Portal)
BUCKET_NAME=acme-handbook

# Telnyx-hosted inference model (no BYOK key needed)
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Company slug used by the bootstrap script (default: acme)
COMPANY=acme
