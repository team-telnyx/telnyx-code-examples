# Local server defaults to simulation. No credentials needed until live mode.
DEMO_MODE=true
PORT=8787
# Leave empty to generate a temporary local token on startup.
SCHEDULER_TOKEN=
SCHEDULER_DB=.data/scheduler.sqlite
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PHONE_NUMBER=+18005550100
TELNYX_CONNECTION_ID=your_connection_id
NOTIFICATION_PHONE_NUMBER=+18005550101
# Exact HTTPS hostnames permitted for live webhook jobs. Redirects are rejected.
WEBHOOK_HOSTS=example.com
