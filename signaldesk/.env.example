# ── Telnyx ────────────────────────────────────────────────────────────────
# Telnyx API key (readable + writable credentials).
# Get one: https://portal.telnyx.com/#/app/api-keys
# Local fallback when Vercel Connect is not configured.
TELNYX_API_KEY=your_telnyx_api_key_here

# E.164 sender number for outbound SMS. Must be a number on your account
# assigned to the SignalDesk messaging profile.
TELNYX_FROM_NUMBER=+18005550100

# Messaging profile used for both sending and receiving SMS.
# When set, outbound sends reference the profile instead of a single number.
TELNYX_MESSAGING_PROFILE_ID=your_messaging_profile_id_here

# Ed25519 PUBLIC key from the Telnyx portal
# (Manage → Keys & Credentials → Ed25519 public key).
# Used to verify webhook signatures. Not a secret, but keep it in env.
TELNYX_PUBLIC_KEY=your_base64_ed25519_public_key_here

# Vercel Connect connector name that provides the Telnyx API key.
# Only used when the app runs on Vercel with Connect installed.
# The connector provides the key via OIDC; no token needed here.
TELNYX_CONNECTOR_NAME=telnyx/signaldesk-telnyx

# ── Vercel AI Gateway ─────────────────────────────────────────────────────
# Required for local development. On Vercel deployments the OIDC token is
# used automatically when this is unset.
# Get one: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=your_ai_gateway_key_here

# Optional: override the classification model. Defaults to zai/glm-5.3-flash,
# which is served by Telnyx on the AI Gateway (Telnyx-only routing). Note:
# free-tier AI Gateway teams cannot call this model (plan_restricted) —
# add AI Gateway credits to unlock it. Override AI_MODEL only if the model
# you need has a telnyx endpoint, or the only:["telnyx"] filter will fail.
# AI_MODEL=zai/glm-5.3-flash

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. Local dev defaults to the Docker container
# started with `npm run db:up`.
DATABASE_URL=postgres://postgres:signaldesk@localhost:54329/signaldesk

# ── Auth.js ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change_me_run_openssl_rand_base64_32

# Operator credentials for the dashboard (Auth.js Credentials provider).
# Hash the password with: npm run hash-password -- <your-password>
SIGNALDESK_OPERATOR_USERNAME=operator
SIGNALDESK_OPERATOR_PASSWORD_HASH=change_me_run_npm_run_hash-password

# ── Mock / development flags ──────────────────────────────────────────────
# SIGNALDESK_MOCK_AI=true  → classify without calling the AI Gateway
#                            (deterministic heuristic; useful for local demos)
# SIGNALDESK_MOCK_AI=false → real inference through Vercel AI Gateway → Telnyx
SIGNALDESK_MOCK_AI=true

# SIGNALDESK_MOCK_SMS=true → outbound SMS is persisted to a local outbox
#                            (/dev/outbox) instead of calling Telnyx.
# SIGNALDESK_MOCK_SMS=false → real sends through the Telnyx Messaging API.
SIGNALDESK_MOCK_SMS=false

# Comma-separated E.164 allowlist of numbers allowed to report incidents.
# Leave empty to allow any inbound number. Example:
# ALLOWED_REPORTER_NUMBERS=+18005550123,+19495550000
ALLOWED_REPORTER_NUMBERS=
