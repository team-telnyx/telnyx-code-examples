# Telnyx Edge Compute credentials (set via `telnyx-edge secrets add`)
# TELNYX_API_KEY=KEY0123456789ABCDEF
# TELNYX_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
# TELNYX_PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# Per-tenant configuration (seeded automatically on first run)
# These are placeholders — override per deployment.
TENANT_A_NAME=Acme Robotics
TENANT_A_VOICE_PROFILE_ID=
TENANT_A_WEBHOOK_URL=https://example.com/tenant-a/webhook

TENANT_B_NAME=Munich Finanz
TENANT_B_VOICE_PROFILE_ID=
TENANT_B_WEBHOOK_URL=https://example.com/tenant-b/webhook

# Local server (the runner that simulates the Edge environment)
PORT=8787
HOST=127.0.0.1
DEMO_MODE=true

# Local SQLite path for the runner. On Edge, KV/SQL are managed by the runtime.
# TENANT_VOICE_DB=.data/multi-tenant.sqlite
