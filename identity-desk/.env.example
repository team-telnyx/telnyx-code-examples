# Telnyx API key \u2014 only read when DEMO_MODE=false (live Number Lookup calls).
TELNYX_API_KEY=your_telnyx_api_key_here

# Safe demo mode (default). true = deterministic fixtures, no Telnyx API calls,
# no charges. Set to false to call GET /v2/number_lookup for real.
DEMO_MODE=true

# Optional: override the Telnyx API base URL (leave as-is for production).
TELNYX_API_BASE=https://api.telnyx.com
