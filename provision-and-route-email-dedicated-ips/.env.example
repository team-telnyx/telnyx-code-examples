# Telnyx API key (required in live mode)
TELNYX_API_KEY=your_telnyx_api_key_here

# Safe demo mode: when true, no real purchase or email is made.
DEMO_MODE=true

# Live-mode email addressing. TELNYX_EMAIL_FROM must be on a verified
# Telnyx email domain. TELNYX_EMAIL_TO must be a mailbox you control.
TELNYX_EMAIL_FROM=no-reply@your-verified-domain.example
TELNYX_EMAIL_TO=you@your-mailbox.example

# Warm-up polling (live mode)
WARMUP_TIMEOUT_SECONDS=300
WARMUP_POLL_INTERVAL_SECONDS=10

# Flask
PORT=5000
