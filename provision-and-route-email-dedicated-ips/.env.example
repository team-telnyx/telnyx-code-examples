# Telnyx API key (required in live mode)
TELNYX_API_KEY=your_telnyx_api_key_here

# Safe demo mode: when true, no real purchase or email is made.
DEMO_MODE=true

# Live-mode email addressing. TELNYX_EMAIL_FROM must be on a verified
# Telnyx email domain. Zero-setup option: use a shared domain, e.g.
# TELNYX_EMAIL_FROM=onboarding@msgtelnyx.com — recipients must then match the
# account owner's verified email address. For full control, register and
# verify your own domain (Portal → Email → Domains) and use any local-part.
TELNYX_EMAIL_FROM=no-reply@your-verified-domain.example
TELNYX_EMAIL_TO=you@your-mailbox.example

# Warm-up polling (live mode)
WARMUP_TIMEOUT_SECONDS=300
WARMUP_POLL_INTERVAL_SECONDS=10

# Optional: resume a previous live run's IP instead of purchasing a new one
# (every purchase starts a $14/month MRC). Leave empty for a fresh purchase.
REUSE_DEDICATED_IP_ID=

# Flask
PORT=5000
