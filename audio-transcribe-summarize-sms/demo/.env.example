# Voicemail Agent Demo — environment variables
# Copy to .env and fill in your values

# Telnyx API key (for STT, LLM, and SMS)
TELNYX_API_KEY=KEY0123456789ABCDEF

# Telnyx phone number to send SMS from (E.164 format)
SENDER_PHONE=+18005551234

# LLM model for summarization (optional, default: zai-org/GLM-5.2)
AI_MODEL=zai-org/GLM-5.2

# Pre-fill recipient phone in the dashboard (optional)
DEMO_RECIPIENT_PHONE=+17177247292

# Server config (optional)
HOST=0.0.0.0
PORT=8000
