# patient-access-hospital-demo — environment configuration
#
# MOCK MODE (default) needs NONE of these: the Edge dev stack runs the full
# demo offline and never places calls or sends SMS.
#
# LIVE MODE is strictly opt-in and FAILS CLOSED. To enable it:
#   1. In telnyx.toml [env_vars]: set DEMO_MODE = "live" and fill every
#      variable below (env vars are committed in telnyx.toml; never put
#      secret VALUES there).
#   2. Register the two secrets on the account (values never enter the repo):
#        telnyx-edge secrets add TELNYX_API_KEY "<api key>"
#        telnyx-edge secrets add TELNYX_PUBLIC_KEY "<base64 public key>"
#   3. Deploy with `npm run ship` and point the Call Control application's
#      webhook_url at https://<function-url>/api/webhooks/telnyx
#
# If any live variable is missing, the app refuses live features and prints
# exactly which ones are missing.

# ── Live mode env vars (telnyx.toml [env_vars]) ─────────────────────────
# Voice AI-enabled Call Control application (connection) ID the outbound
# call is placed through.
TELNYX_CONNECTION_ID=

# Existing Telnyx AI Assistant id used for the outbound call. Per-call
# instructions/dynamic-variables/transfer-tool are passed at dial time.
TELNYX_ASSISTANT_ID=

# Public HTTPS URL of this deployed function. Used by the live assistant's
# reschedule webhook tool.
PUBLIC_BASE_URL=

# Your Telnyx number that places the call and sends the SMS (E.164).
# NOTE: US carriers deliver SMS only from verified origins — a toll-free
# number requires Toll-Free Verification (1-2 weeks); a 10-digit local
# number requires 10DLC registration.
FROM_NUMBER=

# The patient-side phone that live mode calls and texts (E.164).
# MUST be a phone you have explicit permission to call/text.
DEMO_TARGET_PHONE=

# Staff / nurse number the warm transfer connects to (E.164).
STAFF_PHONE=

# ── Secrets (telnyx-edge secrets add) ───────────────────────────────────
# TELNYX_API_KEY    Telnyx API key used by the live call driver (Bearer).
# TELNYX_PUBLIC_KEY Base64 Ed25519 public key; when set, the webhook endpoint
#                   verifies the telnyx-signature-ed25519 headers (401 on
#                   mismatch). Optional but recommended.

# ── Rebranding (telnyx.toml [env_vars], committed) ──────────────────────
# BRAND_NAME   Display name for the fictional clinic (default "Winderval Medical")
# BRAND_ACCENT CSS color for the brand accent (default "#0d9488")
# To complete a rebrand, also swap the LOGO SVG BLOCK in src/ui.ts.

# ── Demo pacing ─────────────────────────────────────────────────────────
# DEMO_PACE_MS (telnyx.toml [env_vars]) — per-beat delay in ms, default 9000.
# Can also be set per-run via POST /api/demo/start {"paceMs": 12000}.
