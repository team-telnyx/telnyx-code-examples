# Telnyx API key — used by the `telnyx-edge` CLI to deploy (`npm run ship`)
# and to provision the function. NOT used by the running sample: inference
# goes through the pre-authenticated TELNYX Edge binding.
TELNYX_API_KEY=your_telnyx_api_key_here

# Inference model served by the TELNYX binding (must be a model it serves).
MODEL=zai-org/GLM-5.2

# "true" serves the demo UI at /; "false" disables it.
DEMO_MODE=true

# Socket credential: WebSocket clients that attach with this token get the
# "rpc" claim (seed/play/pause/speed/commentary). Other clients connect as
# read-only watchers. Change it before exposing the demo publicly.
REPLAY_TOKEN=replay-demo

# Optional: require `Authorization: Bearer <INGEST_TOKEN>` on POST /ingest.
# Leave unset for an open demo endpoint.
INGEST_TOKEN=
