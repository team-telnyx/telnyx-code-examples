# Server-side TrustedRouter API key (required). Create at trustedrouter.com.
# Use a dedicated key with a hard daily spend limit for this demo.
TRUSTEDROUTER_API_KEY=your_trustedrouter_api_key_here

# Recommended for deployed instances: protects the paid inference endpoint.
DEMO_ACCESS_TOKEN=your_demo_access_token_here

# Local or platform-provided HTTP port (Telnyx Edge sets PORT automatically).
PORT=8080

# Maximum prompt length in characters (default 4000).
PROMPT_MAX_CHARS=4000

# Public model catalog cache lifetime in seconds (default 300).
MODEL_CACHE_TTL_SECONDS=300

# TrustedRouter upstream request timeout in milliseconds (default 90000).
REQUEST_TIMEOUT_MS=90000

# Not required for the prepaid v1 path (TrustedRouter Credits routes are used).
# Reserved for a future bring-your-own-key extension to Telnyx Inference.
# TELNYX_API_KEY=
