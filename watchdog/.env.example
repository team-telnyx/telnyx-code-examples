# Telnyx API key - only read when DEMO_MODE=false (Agent Browser is a beta REST API).
TELNYX_API_KEY=your_telnyx_api_key_here

# Public URL of the deployed fixture. Agent Browser sessions run in Telnyx's
# cloud, so this can never be localhost. Append ?price=0.00 to reproduce the broken verdict.
WATCH_TARGET_URL=https://your-fixture-host.example.com/

# Owner phone that receives alert SMS and may text watch/status/recheck.
WATCH_OWNER_PHONE=+1555XXXXXXX

# Telnyx number the alert SMS is sent from.
FROM_NUMBER=+1555XXXXXXX

# true = replay recorded Agent Browser fixtures, no live API calls, no real SMS.
DEMO_MODE=true

# Model used for the verdict + ref-picking turns.
AI_MODEL=moonshotai/Kimi-K2.6

# Telnyx webhook signing public key (Ed25519), for the SMS command webhook. Required in live mode.
TELNYX_PUBLIC_KEY=your_telnyx_webhook_public_key_here
