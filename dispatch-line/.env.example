# Telnyx API key \u2014 used for transcription_start / transcription_stop / speak / answer.
# Never commit a real value. Set it with: telnyx-edge secrets add TELNYX_API_KEY "..."
TELNYX_API_KEY=your_telnyx_api_key_here

# Base64 Ed25519 public key from the Telnyx portal (Webhooks -> public key).
# Used to verify the telnyx-signature-ed25519 header on every inbound webhook.
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Safe demo mode (default true): no real Telnyx API calls are made, requests are logged.
# Set to "false" for live mode.
DEMO_MODE=true
