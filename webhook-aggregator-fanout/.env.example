# Telnyx API credentials
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Webhook configuration
# Port for the Flask server
PORT=5000

# Deduplication settings
# Time in seconds to keep event IDs for deduplication
DEDUP_TTL_SECONDS=300

# Database configuration
# Path to SQLite database file for event logging
DB_PATH=webhook_events.db
