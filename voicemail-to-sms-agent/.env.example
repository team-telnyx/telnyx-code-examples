# Telnyx API Credentials
TELNYX_API_KEY=your_telnyx_api_key_here

# Webhook signature verification (Ed25519 public key from Mission Control Portal).
# Stored as an Edge secret named VOICEMAIL_WEBHOOK_PUBLIC_KEY to verify Telnyx signatures.
VOICEMAIL_WEBHOOK_PUBLIC_KEY=your_telnyx_ed25519_public_key_here

# Phone Numbers (E.164 format)
TELNYX_SMS_NUMBER=+1555XXXXXXX
MAILBOX_OWNER_NUMBER=+1555XXXXXXX

# AI Models (Telnyx-hosted, no BYOK required)
AI_MODEL=moonshotai/Kimi-K2.6
STT_MODEL=distil-whisper/distil-large-v2
# Telnyx Edge Configuration
TELNYX_EDGE_APP_ID=your_edge_app_id_here

# Phone Numbers (E.164 format)
TELNYX_SMS_NUMBER=+1555XXXXXXXX
MAILBOX_OWNER_NUMBER=+1555XXXXXXXX

# Cloud Storage
STORAGE_BUCKET=voicemail-archives

# Mode: "true" for live mode (sends real SMS + archives audio), "false" for demo mode (logs only)
# Mode: "true" for live mode (sends real SMS), "false" for demo mode (logs only)
LIVE_MODE=false
