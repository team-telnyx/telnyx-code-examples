# Telnyx API key (https://portal.telnyx.com/api-keys)
TELNYX_API_KEY=your_telnyx_api_key

# Telnyx public key for Ed25519 webhook signature verification.
# Find it in the portal under API Keys -> Webhook Signing Key (or set TELNYX_PUBLIC_KEY here).
# If left blank, webhook signatures are NOT verified (fine for local dev, NOT for production).
TELNYX_PUBLIC_KEY=your_telnyx_public_key

# Email API sending domain. Use a Telnyx shared domain (e.g. mail.telnyxemail.com)
# or your own verified domain. The inbox address must be on this domain.
EMAIL_SENDING_DOMAIN=mail.telnyxemail.com

# Inbox address that receives inbound emails. Must be on the sending domain.
# Customer emails sent to this address trigger the AI reply flow.
INBOX_ADDRESS=agent@mail.telnyxemail.com

# Display name shown in the From: header of AI-generated replies.
AGENT_DISPLAY_NAME=Nyx AI Agent

# Telnyx AI Inference model (https://developers.telnyx.com/docs/inference/models)
AI_MODEL=moonshotai/Kimi-K2.6

# Agent persona — system prompt that defines how the AI replies to emails.
AGENT_SYSTEM_PROMPT=You are Nyx, a friendly AI email assistant for a Telnyx demo. Reply to customer emails with helpful, concise, professional responses. Keep replies under 150 words. Sign off as "Nyx, Telnyx AI Agent". Do not make up facts about Telnyx pricing or specifics — if unsure, suggest visiting telnyx.com or contacting support.

# Max tokens for AI-generated reply.
MAX_TOKENS=400

# Public HTTPS URL of THIS app (your ngrok/cloudflare-tunnel URL).
# Telnyx webhooks must point here: https://<this>/webhooks/email
TELNYX_PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# Server
HOST=0.0.0.0
PORT=8000
