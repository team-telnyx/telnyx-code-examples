# Telnyx API key (https://portal.telnyx.com/api-keys)
TELNYX_API_KEY=your_telnyx_api_key

# Telnyx public key for Ed25519 webhook signature verification.
# Find it in the portal under API Keys -> Webhook Signing Key (or set TELNYX_PUBLIC_KEY here).
# If left blank, webhook signatures are NOT verified (fine for local dev, NOT for production).
TELNYX_PUBLIC_KEY=your_telnyx_public_key

# Email API sending domain. Three options:
#
# 1. shared_inbound (RECOMMENDED for demo): set this to the msgtelnyx.com
#    subdomain that Telnyx auto-provisioned when you created your inbox
#    via POST /v2/email_inboxes with "domain" as a string name. No DNS
#    needed. The inbox can both receive AND send. Example: wabsxpjb74sb.msgtelnyx.com
#
# 2. Shared sandbox domain (limited): mail.telnyx.com or msgtelnyx.com.
#    Sandbox mode — from-address must be onboarding@<domain> and
#    recipients must be verified on your Telnyx account.
#
# 3. Custom verified domain: your own domain via POST /v2/email_domains,
#    publish the DNS records, verify. Then any address on that domain
#    can send to any recipient.
EMAIL_SENDING_DOMAIN=your-subdomain.msgtelnyx.com

# Inbox address that receives inbound emails.
#
# EASIEST PATH — shared_inbound domain (no DNS needed):
#   When you create an inbox via POST /v2/email_inboxes with "domain" as a
#   string name (not a domain_id), Telnyx auto-provisions it on a
#   Telnyx-managed shared_inbound subdomain (e.g. wabsxpjb74sb.msgtelnyx.com).
#   Telnyx manages the MX records — no DNS verification required.
#   The inbox can both RECEIVE (MX → mx.telnyx.com) and SEND email.
#
# Example: inbox-<random>@<random>.msgtelnyx.com
#
# ALTERNATE PATH — shared sandbox domain (limited):
#   For shared sandbox domains (mail.telnyx.com, msgtelnyx.com) the from-
#   address must be onboarding@<domain> and recipients must be verified
#   on your Telnyx account. Use this only for quick local testing.
#
# ALTERNATE PATH — custom verified domain:
#   Create your own domain via POST /v2/email_domains, publish the DNS
#   records, and verify it. Then any address on that domain can send to
#   any recipient. Not needed for the demo if you use shared_inbound.
INBOX_ADDRESS=inbox-yourinbox@your-subdomain.msgtelnyx.com

# Address the agent sends replies FROM. Defaults to INBOX_ADDRESS if unset.
# Set this only if you want replies to come from a different address than
# the inbound inbox (e.g. a shared_inbound inbox that sends from itself).
REPLY_FROM_ADDRESS=inbox-yourinbox@your-subdomain.msgtelnyx.com

# Display name shown in the From: header of AI-generated replies.
AGENT_DISPLAY_NAME=Nyx AI Agent

# Telnyx AI Inference model (https://developers.telnyx.com/docs/inference/models)
AI_MODEL=moonshotai/Kimi-K2.6

# Agent persona — system prompt that defines how the AI replies to emails.
AGENT_SYSTEM_PROMPT=You are Nyx, a friendly AI email assistant for a Telnyx demo. Reply to customer emails with helpful, concise, professional responses. Keep replies under 150 words. Sign off as "Nyx, Telnyx AI Agent". Do not make up facts about Telnyx pricing or specifics — if unsure, suggest visiting telnyx.com or contacting support.

# Max tokens for AI-generated reply. 2000 gives the reasoning model room
# to think; lower it to ~400 for shorter, cheaper replies.
MAX_TOKENS=2000

# Public HTTPS URL of THIS app (your ngrok/cloudflare-tunnel URL).
# Telnyx webhooks must point here: https://<this>/webhooks/email
TELNYX_PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# Server
HOST=0.0.0.0
PORT=8000
