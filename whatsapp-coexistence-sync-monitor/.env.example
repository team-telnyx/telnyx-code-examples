# Telnyx API credentials (from Portal > Keys & Credentials)
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# WhatsApp Business Account ID (from your WhatsApp number)
WABA_ID=your_waba_id_here

# The coexistence-enabled WhatsApp number to monitor
WHATSAPP_NUMBER=+1555XXXXXXXX

# Path for the append-only log file
ECHO_LOG_PATH=echo_log.jsonl

# Safe demo mode: true = no real API calls, simulated state
DEMO_MODE=true

# State check cache TTL (seconds)
STATE_CHECK_TTL_SECONDS=60

# Max allowed timestamp skew for webhook signature verification (seconds)
MAX_TIMESTAMP_SKEW_SECONDS=300

# Port for the Flask server
PORT=5000
