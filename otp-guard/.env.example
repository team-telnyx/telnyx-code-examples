# Telnyx API credentials \u2014 never commit real values.
TELNYX_API_KEY=your_telnyx_api_key_here

# Telnyx webhook signing public key (Ed25519, base64).
# Required by POST /webhooks/verify \u2014 the route fails closed (503) without it.
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Safe demo mode. true  = Verify calls are stubbed inline, no real SMS is sent.
#                     false = live Verify API + real SMS notifications.
DEMO_MODE=true

# E.164 phone number used by the demo flows (never a real number in the repo).
DEMO_PHONE=+1555XXXXXXXX

# Optional: reuse an existing step-up verify profile instead of creating one.
VERIFY_PROFILE_ID=

# Public base URL of this deployment \u2014 used as the verify profile webhook_url.
PUBLIC_BASE_URL=https://your-app.example.com

# Telnyx number used for SMS notifications (live mode only).
DISPATCH_FROM_NUMBER=+1555XXXXXXXX
