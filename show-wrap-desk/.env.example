# Telnyx API v2 key (required). Get one at https://portal.telnyx.com/api-keys
TELNYX_API_KEY=your_telnyx_api_key_here

# Deployed function URL — printed by `npm run deploy` (telnyx-edge ship).
# Example: https://show-wrap-desk-8585aaaa-c.telnyxcompute.com
DEPLOY_URL=

# The demo episode (public-domain audio, any mp3/wav URL the edge function can fetch)
EPISODE_URL=https://archive.org/download/sonnet_116_librivox/sonnet_116_shakespeare_add_64kb.mp3

# AI Inference model used for chapter titles, show notes, and the trailer script
AI_MODEL=zai-org/GLM-5.3-Flash

# TTS voice for the trailer (see GET /text-to-speech/voices for the full list)
HOST_VOICE=azure.en-US-AvaMultilingualNeural
